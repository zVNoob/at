c2451c-5306-40a4-8ff1-c3c6a1d92572",1]]],["constraint",[["0dc2451c-5306-40a4-8ff1-c3c6a1d92572",1]]],["not",[["0dc2451c-5306-40a4-8ff1-c3c6a1d92572",1]]],["satisfied",[["0dc2451c-5306-40a4-8ff1-c3c6a1d92572",1]]],["satisfi",[["0dc2451c-5306-40a4-8ff1-c3c6a1d92572",1]]],["npos",[["0dc2451c-5306-40a4-8ff1-c3c6a1d92572",1]]],["true",[["0dc2451c-5306-40a4-8ff1-c3c6a1d92572",1]]],["semantic_constraint",[["0dc2451c-5306-40a4-8ff1-c3c6a1d92572",1]]]],"chunkMap":{"af44931b-25d8-47b8-82c9-e7c3c40b5cc4":{"id":"af44931b-25d8-47b8-82c9-e7c3c40b5cc4","content":"int main() {\n    std::string input = \"x : int = 42;\\ny : int = x + 1;\\n\";\n    at::AstPtr ast = at::parseSource(input);\n    assert(ast != nullptr);\n    std::cout << \"parser_basic: PASS\\n\";\n    return 0;\n}","description":"This C++ code tests a parser function by validating its output for basic AST construction from a simple input string.","filePath":"/home/may/Projects/at/tests/parser_basic.cpp","startLine":7,"endLine":13,"language":"cpp","kind":"","role":"test","quirkType":"","tags":""},"5a7c9ba0-c739-4060-893c-e68474b921c0":{"id":"5a7c9ba0-c739-4060-893c-e68474b921c0","content":"int main() {\n    std::vector<std::string> samples = {\n        // class declaration via alias\n        \"Foo := # (x : int) { x; };\\n\",\n        \"Foo := # (x : int) : int { x; };\\n\",\n        // function declaration\n        \"f : @? (a : int) = @ (a : int) { @< a + 1; };\\n\",\n        // unwrap\n        \"* (x) { x; };\\n\",\n        \"* (x) { x; } : { 0; };\\n\",\n        // try cast\n        \"? (x -> int) { x; };\\n\",\n        \"? (x -> int) { x; } : { 0; };\\n\",\n        // cast only valid in try-cast statements\n        \"? (x -> int) { x; };\\n\",\n        // array and construction\n        \"arr = [1, 2, 3];\\n\",\n        \"p = Point <{ 1, 2 }>;\\n\",\n        // control flow\n        \"(x <= 10) ? { 0; } : { 1; };\\n\",\n        \"$ (x) { x; };\\n\",\n        \"$ (i : int) { i; };\\n\",\n        // template\n        \"Foo := <| T |> # () { };\\n\",\n        // overloading\n        \"+ ^= f;\\n\",\n        \"g ^= h;\\n\",\n        // borrowing\n        \"r = &x;\\n\",\n        // pointer declaration\n        \"ptr : * int = 0;\\n\",\n    };\n\n    for (const auto& sample : samples) {\n        at::AstPtr ast = at::parseSource(sample);\n        if (!ast) {\n            std::cerr << \"FAILED to parse: \" << sample;\n            return 1;\n        }\n    }\n    std::cout << \"parser_features: PASS (\" << samples.size() << \" samples)\\n\";\n    return 0;\n}","description":"The C++ parser tests script processes a series of sample source code strings to validate their syntactic correctness using the `at::parseSource` function.","filePath":"/home/may/Projects/at/tests/parser_features.cpp","startLine":8,"endLine":50,"language":"cpp","kind":"","role":"test","quirkType":"","tags":""},"b1b0da56-b41b-4ba7-bfcf-11158ef38fef":{"id":"b1b0da56-b41b-4ba7-bfcf-11158ef38fef","content":"int main() {\n    at::Lexer lexer(\"  my man   \", \"ws\");\n    auto tokens = lexer.tokenize();\n    assert(tokens.size() >= 2); // IDENTIFIER + EOF\n    assert(tokens[0].kind == parser::Parser::token::IDENTIFIER);\n    assert(tokens[0].lexeme == \"my man\");\n    std::cout << \"lexer_ws: PASS\\n\";\n    return 0;\n}","description":"The C++ program tests a lexer for whitespace-separated tokens in a string, ensuring correct tokenization and assertions are met.","filePath":"/home/may/Projects/at/tests/lexer_ws.cpp","startLine":8,"endLine":16,"language":"cpp","kind":"","role":"test","quirkType":"","tags":""},"f3f0eb5f-a3b5-4875-b647-3208bebf0590":{"id":"f3f0eb5f-a3b5-4875-b647-3208bebf0590","content":"int main() {\n    // Write a small module file\n    std::ofstream mod(\"tests/import_mod.at\");\n    mod << \"100;\\n\";\n    mod.close();\n\n    std::string input = \"'tests/import_mod.at';\\n\";\n    auto ast = at::parseSource(input);\n    assert(ast != nullptr);\n\n    at::SemanticAnalyzer sem;\n    sem.analyze(ast);\n    if (!sem.errors().empty()) {\n        std::cout << \"sem errors: \" << sem.errors().size() << \"\\n\";\n        return 1;\n    }\n\n    at::Interpreter interp;\n    at::Value r = interp.run(ast);\n    assert(r.kind == at::Value::Kind::Int);\n    assert(r.intValue == 100);\n\n    // Second import should hit cache\n    at::Value r2 = interp.run(ast);\n    assert(r2.intValue == 100);\n\n    std::cout << \"interpreter_import: PASS\\n\";\n    return 0;\n}","description":"This C++ test script imports and re-executes a cached module to verify interpreter performance and reliability.","filePath":"/home/may/Projects/at/tests/interpreter_import.cpp","startLine":10,"endLine":38,"language":"cpp","kind":"","role":"test","quirkType":"","tags":""},"41c2b4a1-660c-4176-9563-c0150267f4b1":{"id":"41c2b4a1-660c-4176-9563-c0150267f4b1","content":"int main() {\n    std::string input = \"x : int = 41;\\ny : int = x + 1;\\ny;\\n\";\n    auto ast = at::parseSource(input);\n    assert(ast != nullptr);\n\n    at::SemanticAnalyzer sem;\n    sem.analyze(ast);\n    if (!sem.errors().empty()) {\n        std::cout << \"sem errors: \" << sem.errors().size() << \"\\n\";\n        return 1;\n    }\n\n    at::CodeGen cg;\n    std::string out = \"/tmp/opencode/compile_test.o\";\n    assert(cg.compile(ast, out));\n\n    // Verify it's a valid ELF object\n    std::ifstream f(out, std::ios::binary);\n    assert(f.is_open());\n    char magic[4];\n    f.read(magic, 4);\n    assert(magic[0] == 0x7f && magic[1] == 'E' && magic[2] == 'L' && magic[3] == 'F');\n\n    std::cout << \"compile_test: PASS\\n\";\n    return 0;\n}","description":"This C++ script tests compilation of a simple AST by parsing, analyzing, and verifying the output object file's format.","filePath":"/home/may/Projects/at/tests/compile_test.cpp","startLine":10,"endLine":35,"language":"cpp","kind":"","role":"test","quirkType":"","tags":""},"0dc2451c-5306-40a4-8ff1-c3c6a1d92572":{"id":"0dc2451c-5306-40a4-8ff1-c3c6a1d92572","content":"int main() {\n    std::string input = \"Foo := <| T |> @ (a : T) { @< a + 1; };\\nFoo(\\\"a\\\");\\n\";\n    at::AstPtr ast = at::parseSource(input);\n    assert(ast != nullptr);\n    at::SemanticAnalyzer sem;\n    sem.analyze(ast);\n    bool found = false;\n    for (const auto& e : sem.errors()) {\n        if (e.message.find(\"constraint not satisfied\") != std::string::npos) found = true;\n    }\n    assert(found);\n    std::cout << \"semantic_constraint: PASS\\n\";\n    return 0;\n}","description":"Cpp test file for semantic constraint analysis, taking input string, parsing, analyzing, and checking for specific error message.","filePath":"/home/may/Projects/at/tests/semantic_constraint.cpp","startLine":8,"endLine":21,"language":"cpp","kind":"","role":"test","quirkType":"","tags":""}}}